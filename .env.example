# Optional PostgreSQL connection for server-side cache/state persistence.
# Use either QMS_DATABASE_URL or the PG* variables below.
QMS_DATABASE_URL=postgresql://qms_app:change-this-password@127.0.0.1:5432/qms
# QMS_PG_POOL_MAX=10
# QMS_PG_CONNECT_TIMEOUT_MS=5000
# QMS_PG_IDLE_TIMEOUT_MS=30000

# Existing server settings
# HOST=0.0.0.0
# PORT=4173
# QMS_DATA_DIR=./data
# PDF page extraction. Python must include pypdf; pdftoppm comes from Poppler.
# QMS_PYTHON=/usr/bin/python3
# QMS_PDFTOPPM=/usr/bin/pdftoppm
# Knowledge distillation background task limits. Keep batches bounded to avoid
# browser/server memory spikes and upstream model timeouts.
# QMS_KNOWLEDGE_DISTILL_MAX_CLAUSES=5000
# QMS_KNOWLEDGE_DISTILL_BATCH_CHARS=12000
# QMS_KNOWLEDGE_DISTILL_BATCH_CLAUSES=50
# QMS_KNOWLEDGE_DISTILL_RETRIES=2
# Public/LAN address used by Share -> WeChat report links.
# VITE_PUBLIC_APP_URL=http://your-qms-server:4173
